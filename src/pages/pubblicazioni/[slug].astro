---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeaderIsland from '../../components/HeaderIsland.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import site from '../../data/site.json';
import { pubblicazioni, type Pubblicazione } from '../../data/pubblicazioni';

export function getStaticPaths() {
  return pubblicazioni.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Pubblicazione };
const siteUrl = site.siteUrl.replace(/\/$/, '');
const pageUrl = `${siteUrl}/pubblicazioni/${p.slug}/`;
const pdfUrl = `/pubblicazioni/${p.slug}.pdf`;
const coverUrl = `/pubblicazioni/${p.slug}.webp`;
const title = `${p.title}: white paper in PDF | Sfratto Sicuro`;
const description = p.lede;
const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const others = pubblicazioni.filter((x) => x.slug !== p.slug);

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'it-IT',
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntity: { '@id': `${pageUrl}#document` }
    },
    {
      '@type': 'DigitalDocument',
      '@id': `${pageUrl}#document`,
      name: p.title,
      alternativeHeadline: p.subtitle,
      description: p.lede,
      genre: p.kind,
      inLanguage: 'it-IT',
      numberOfPages: p.pages,
      datePublished: p.published,
      dateModified: p.updated,
      isAccessibleForFree: true,
      audience: { '@type': 'Audience', audienceType: p.audience },
      keywords: p.topics.join(', '),
      image: `${siteUrl}${coverUrl}`,
      author: { '@type': 'Person', '@id': 'https://www.daniloansalone.it/#person', name: 'Danilo Ansalone', jobTitle: 'Avvocato' },
      publisher: { '@id': `${siteUrl}/#organization` },
      encoding: {
        '@type': 'MediaObject',
        contentUrl: `${siteUrl}${pdfUrl}`,
        encodingFormat: 'application/pdf'
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Pubblicazioni', item: `${siteUrl}/pubblicazioni/` },
        { '@type': 'ListItem', position: 3, name: p.title, item: pageUrl }
      ]
    }
  ]
};
---

<SiteLayout title={title} description={description} canonicalPath={`/pubblicazioni/${p.slug}/`} image={coverUrl} type="article">
  <Fragment slot="head">
    <JsonLd graph={graph} />
  </Fragment>
  <HeaderIsland />

  <main id="main-content" class="pub-page">
    <nav class="pub-crumbs" aria-label="Percorso">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/pubblicazioni/">Pubblicazioni</a>
    </nav>

    <section class="pub-hero">
      <div class="pub-hero__text">
        <p class="eyebrow">{p.kind} · Edizione {fmtDate(p.updated).replace(/^\d+ /, '')}</p>
        <h1 class="pub-title">{p.title}</h1>
        <p class="pub-sub">{p.subtitle}</p>
        <p class="pub-lede">{p.lede}</p>
        <dl class="pub-meta">
          <div><dt>Formato</dt><dd>PDF, {p.sizeMb} MB</dd></div>
          <div><dt>Pagine</dt><dd>{p.pages}</dd></div>
          <div><dt>Aggiornato al</dt><dd>{fmtDate(p.updated)}</dd></div>
          <div><dt>Autore</dt><dd>Avv. Danilo Ansalone</dd></div>
        </dl>
        <div class="pub-actions">
          <a class="pub-btn" href={pdfUrl} download data-pub-download={p.slug}>
            Scarica il PDF
            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11"></path><path d="m7 10 5 5 5-5"></path><path d="M5 20h14"></path></svg>
          </a>
          <a class="pub-btn pub-btn--ghost" href={pdfUrl} target="_blank" rel="noopener">Leggi online</a>
        </div>
      </div>
      <a class="pub-hero__cover" href={pdfUrl} target="_blank" rel="noopener" aria-label={`Apri il PDF: ${p.title}`}>
        <img src={coverUrl} alt={`Copertina: ${p.title}`} width="600" height="848" loading="eager" decoding="async" />
      </a>
    </section>

    <div class="pub-body">
      <section class="pub-block" aria-labelledby="abstract-title">
        <h2 id="abstract-title">Di che cosa parla</h2>
        {p.abstract.map((para) => <p>{para}</p>)}
        <ul class="pub-topics" aria-label="Argomenti">
          {p.topics.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <section class="pub-block" aria-labelledby="indice-title">
        <h2 id="indice-title">Indice</h2>
        <ol class="pub-index">
          {p.indice.map((voce) => <li>{voce}</li>)}
        </ol>
      </section>
    </div>

    <section class="pub-cta" aria-labelledby="cta-title">
      <div>
        <p class="eyebrow">Il Suo caso</p>
        <h2 id="cta-title">Ha un inquilino che non paga o non lascia l'immobile?</h2>
        <p>La guida descrive le regole in termini generali. Per sapere come applicarle alla Sua situazione può richiedere una valutazione allo Studio.</p>
      </div>
      <a class="pub-btn pub-btn--light" href="/#contatti">Richiedi una consulenza</a>
    </section>

    <section class="pub-others" aria-labelledby="altre-title">
      <h2 id="altre-title">Altre pubblicazioni</h2>
      <ul>
        {others.map((o) => (
          <li>
            <a href={`/pubblicazioni/${o.slug}/`}>
              <img src={`/pubblicazioni/${o.slug}.webp`} alt="" width="120" height="170" loading="lazy" decoding="async" />
              <span><strong>{o.title}</strong><small>{o.subtitle}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="pub-disclaimer">
      Le pubblicazioni hanno finalità esclusivamente informative, descrivono la normativa vigente alla data di aggiornamento indicata
      e non costituiscono parere legale o fiscale. È consentita la condivisione integrale del PDF, citando la fonte.
    </p>
  </main>

  <Footer />
</SiteLayout>

<style>
  .pub-page {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(24px, 4vw, 48px) var(--container-px) clamp(48px, 7vw, 96px);
  }
  .pub-crumbs { display: flex; gap: 8px; font-size: var(--text-small); color: var(--text-muted); margin-bottom: var(--space-lg); }
  .pub-crumbs a { color: var(--link-blue); text-decoration: none; }
  .pub-crumbs a:hover { text-decoration: underline; }
  .pub-hero {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: center;
    padding-bottom: clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--border-medium);
  }
  .pub-hero .eyebrow { margin: 0 0 12px; }
  .pub-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0 0 10px;
  }
  .pub-sub { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.1rem, 1.8vw, 1.35rem); color: var(--gold-refined); margin: 0 0 18px; }
  .pub-lede { font-size: var(--text-lead); line-height: 1.6; color: var(--text-body); margin: 0 0 24px; max-width: 60ch; }
  .pub-meta { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 8px 28px; margin: 0 0 28px; }
  .pub-meta div { display: flex; flex-direction: column; gap: 2px; }
  .pub-meta dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .pub-meta dd { margin: 0; font-weight: 600; color: var(--text-strong); }
  .pub-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .pub-btn {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--green-security-deep); color: #fff; text-decoration: none;
    font-weight: 700; padding: 13px 24px; border-radius: var(--radius-pill);
    border: 1.5px solid var(--green-security-deep);
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .pub-btn:hover { background: var(--blue-navy); border-color: var(--blue-navy); color: #fff; }
  .pub-btn--ghost { background: transparent; color: var(--text-strong); border-color: var(--border-medium); }
  .pub-btn--ghost:hover { background: var(--surface-soft); color: var(--text-strong); border-color: var(--text-strong); }
  .pub-btn--light { background: #fff; color: var(--blue-navy); border-color: #fff; }
  .pub-btn--light:hover { background: var(--gold-warm); border-color: var(--gold-warm); color: var(--blue-navy); }
  .pub-hero__cover { justify-self: center; max-width: 360px; width: 100%; }
  .pub-hero__cover img {
    display: block; width: 100%; height: auto; border-radius: 8px;
    box-shadow: var(--shadow-deep);
    transform: rotate(1.2deg);
    transition: transform .35s ease;
  }
  .pub-hero__cover:hover img { transform: rotate(0deg) translateY(-4px); }

  .pub-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(28px, 6vw, 80px);
    padding-block: clamp(32px, 5vw, 56px);
  }
  .pub-block h2 {
    font-family: var(--font-serif); font-weight: 500; font-size: var(--text-h2);
    color: var(--text-strong); margin: 0 0 16px;
  }
  .pub-block p { line-height: 1.7; color: var(--text-body); margin: 0 0 14px; max-width: 68ch; }
  .pub-topics { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pub-topics li {
    font-size: 0.82rem; font-weight: 600; color: var(--blue-navy-soft);
    background: var(--surface-soft); border: 1px solid var(--border-light);
    border-radius: var(--radius-pill); padding: 4px 12px;
  }
  .pub-index { margin: 0; padding: 0; list-style: none; counter-reset: idx; border-top: 1px solid var(--border-light); }
  .pub-index li {
    counter-increment: idx; display: flex; gap: 14px; align-items: baseline;
    padding: 10px 0; border-bottom: 1px solid var(--border-light); color: var(--text-strong); font-weight: 500;
  }
  .pub-index li::before {
    content: counter(idx, decimal-leading-zero);
    font-family: var(--font-serif); font-weight: 600; color: var(--gold-refined); min-width: 2ch;
  }

  .pub-cta {
    display: flex; align-items: center; justify-content: space-between; gap: 24px 48px; flex-wrap: wrap;
    background: var(--surface-night); color: var(--text-on-dark);
    border-radius: var(--radius-lg); padding: clamp(24px, 4vw, 44px);
  }
  .pub-cta .eyebrow { color: var(--gold-warm); margin: 0 0 8px; }
  .pub-cta h2 { font-family: var(--font-serif); font-weight: 500; font-size: var(--text-h2); margin: 0 0 8px; color: #fff; }
  .pub-cta p { margin: 0; max-width: 60ch; color: oklch(0.88 0.01 250); line-height: 1.6; }

  .pub-others { padding-top: clamp(32px, 5vw, 56px); }
  .pub-others h2 { font-family: var(--font-serif); font-weight: 500; font-size: var(--text-h3); margin: 0 0 16px; color: var(--text-strong); }
  .pub-others ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .pub-others a {
    display: flex; gap: 14px; align-items: center; text-decoration: none; color: inherit;
    padding: 12px; border: 1px solid var(--border-light); border-radius: var(--radius-md); background: var(--surface-card);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .pub-others a:hover { border-color: var(--border-medium); box-shadow: var(--shadow-elevated); }
  .pub-others img { width: 60px; height: auto; border-radius: 4px; box-shadow: var(--shadow-soft); flex: 0 0 auto; }
  .pub-others span { display: flex; flex-direction: column; gap: 4px; }
  .pub-others strong { font-family: var(--font-serif); font-weight: 600; color: var(--text-strong); line-height: 1.2; }
  .pub-others small { color: var(--text-muted); line-height: 1.4; }
  .pub-disclaimer { margin-top: var(--space-xl); font-size: var(--text-small); color: var(--text-muted); max-width: 90ch; }

  @media (max-width: 860px) {
    .pub-hero, .pub-body { grid-template-columns: 1fr; }
    .pub-hero__cover { order: -1; max-width: 220px; }
    .pub-meta { grid-template-columns: repeat(2, auto); }
  }
</style>
