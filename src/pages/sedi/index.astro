---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HeaderIsland from '../../components/HeaderIsland.astro';
import Footer from '../../components/Footer.astro';
import JsonLd from '../../components/JsonLd.astro';
import sedi from '../../data/sedi.json';
import site from '../../data/site.json';

type SedeItem = {
  nome: string;
  slug: string;
  regione: string;
  tribunale?: string;
};

const list = (sedi as SedeItem[])
  .slice()
  .sort((a, b) => a.regione.localeCompare(b.regione, 'it') || a.nome.localeCompare(b.nome, 'it'));

const grouped = list.reduce((acc, item) => {
  if (!acc[item.regione]) acc[item.regione] = [];
  acc[item.regione].push(item);
  return acc;
}, {} as Record<string, SedeItem[]>);

const regionNames = Object.keys(grouped).sort((a, b) => a.localeCompare(b, 'it'));
const totalSedi = list.length;
const totalRegioni = regionNames.length;

const topCities = ['Milano', 'Roma', 'Napoli', 'Torino', 'Bologna', 'Firenze'];
const chipCities = topCities.filter((name) => list.some((c) => c.nome === name));

const regionToId = (region: string) => `regione-${region.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const siteUrl = site.siteUrl.replace(/\/$/, '');

// Dataset compatto per la ricerca live lato client
const cityData = list.map((c) => ({ nome: c.nome, slug: c.slug, regione: c.regione }));

const sediItemList = list.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: `Avvocato per sfratto a ${item.nome}`,
  url: `${siteUrl}/sedi/${item.slug}/`
}));

const sediGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: site.organization.name,
      inLanguage: 'it-IT',
      publisher: { '@id': `${siteUrl}/#organization` }
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: site.organization.name,
      legalName: site.organization.legalName,
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: site.organization.logoUrl
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}/sedi/#breadcrumbs`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Sedi', item: `${siteUrl}/sedi/` }
      ]
    },
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl}/sedi/#collectionpage`,
      url: `${siteUrl}/sedi/`,
      name: 'Sedi territoriali | Sfratto Sicuro',
      description: 'Elenco delle sedi territoriali e presidi operativi in Italia per assistenza legale nelle procedure di sfratto.',
      inLanguage: 'it-IT',
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#organization` },
      breadcrumb: { '@id': `${siteUrl}/sedi/#breadcrumbs` },
      mainEntity: { '@id': `${siteUrl}/sedi/#itemlist` }
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/sedi/#itemlist`,
      name: 'Elenco sedi territoriali',
      numberOfItems: totalSedi,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: sediItemList
    }
  ]
};
---

<SiteLayout
  title="Sedi territoriali | Sfratto Sicuro"
  description="Elenco delle sedi territoriali e presidi operativi in Italia per assistenza legale nelle procedure di sfratto."
  canonicalPath="/sedi/"
>
  <Fragment slot="head">
    <JsonLd graph={sediGraph} />
  </Fragment>

  <HeaderIsland />

  <main id="main-content">
    <section class="sedi-hero">
      <div class="container">
        <p class="editorial-eyebrow">Rete territoriale</p>
        <h1>Sedi territoriali</h1>
        <p class="hero-sub">Trova la sede di riferimento per città o regione e apri la pagina locale dedicata.</p>
        <div class="stats" aria-label="Statistiche sedi">
          <span><span class="stat-num">{totalSedi}</span><span class="stat-label">sedi operative</span></span>
          <span><span class="stat-num">{totalRegioni}</span><span class="stat-label">regioni coperte</span></span>
        </div>
      </div>
    </section>

    <section class="sedi-search">
      <div class="container">
        <div class="tools-grid">
          <label class="field">
            <span>Cerca città</span>
            <input id="citySearch" type="search" autocomplete="off" placeholder="Es. Milano, Roma, Napoli…" aria-label="Cerca una città" />
          </label>

          <label class="field field--region">
            <span>Filtra per regione</span>
            <select id="regionFilter" aria-label="Filtra per regione">
              <option value="">Tutte le regioni</option>
              {regionNames.map((region) => (
                <option value={region}>{region}</option>
              ))}
            </select>
          </label>

          <button id="resetFilters" type="button" class="btn-reset">Reset</button>
        </div>

        <div class="quick-links">
          <p class="quick-title">Città più cercate</p>
          <div class="chips">
            {chipCities.map((city) => (
              <button type="button" class="city-chip" data-city-chip={city}>{city}</button>
            ))}
          </div>
        </div>

        <p id="resultsCounter" class="results-counter" aria-live="polite" hidden></p>
        <p id="noResults" class="no-results" hidden>Nessuna sede trovata. Prova con un altro nome o regione.</p>
        <div id="searchResults" class="search-results" hidden></div>
      </div>
    </section>

    <div id="directory">
      <section class="section section--compact">
        <nav class="container region-index" id="regionIndex" aria-label="Indice regioni">
          {regionNames.map((region) => (
            <a href={`#${regionToId(region)}`}>{region}</a>
          ))}
        </nav>
      </section>

      <section class="section section--compact">
        <div class="container">
          <div class="region-list" id="regionList">
            {regionNames.map((region, index) => {
              const indexLabel = String(index + 1).padStart(2, '0') + ' / ' + String(regionNames.length).padStart(2, '0');
              return (
                <section class="region" data-region={region} id={regionToId(region)}>
                  <header class="region-head">
                    <span class="region-num">{indexLabel}</span>
                    <h2>
                      {region}
                      <span class="count">{grouped[region].length} sedi</span>
                    </h2>
                  </header>
                  <ul class="city-grid">
                    {grouped[region].map((item) => (
                      <li><a href={`/sedi/${item.slug}/`}>Avvocato per sfratto a {item.nome}</a></li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </div>
        </div>
      </section>
    </div>

    <script type="application/json" id="cityData" set:html={JSON.stringify(cityData)}></script>
  </main>

  <Footer />
</SiteLayout>

<script>
  const dataEl = document.getElementById('cityData');
  const cities = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const searchInput = document.getElementById('citySearch') as HTMLInputElement | null;
  const regionFilter = document.getElementById('regionFilter') as HTMLSelectElement | null;
  const resetBtn = document.getElementById('resetFilters');
  const panel = document.getElementById('searchResults');
  const directory = document.getElementById('directory');
  const counter = document.getElementById('resultsCounter');
  const noResults = document.getElementById('noResults');
  const chips = Array.from(document.querySelectorAll('[data-city-chip]'));

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  const render = () => {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const reg = regionFilter?.value || '';
    const active = q !== '' || reg !== '';

    if (!active) {
      if (panel) { panel.hidden = true; panel.innerHTML = ''; }
      if (directory) directory.hidden = false;
      if (counter) counter.hidden = true;
      if (noResults) noResults.hidden = true;
      return;
    }

    const matches = cities
      .filter((c: any) => (!q || c.nome.toLowerCase().includes(q)) && (!reg || c.regione === reg))
      .sort((a: any, b: any) => a.nome.localeCompare(b.nome, 'it'));

    if (directory) directory.hidden = true;
    if (counter) {
      counter.hidden = false;
      counter.textContent = matches.length === 1 ? '1 sede trovata' : `${matches.length} sedi trovate`;
    }
    if (noResults) noResults.hidden = matches.length !== 0;
    if (panel) {
      panel.hidden = false;
      panel.innerHTML = matches
        .map((c: any) => `<a href="/sedi/${c.slug}/"><span class="r-city">Avvocato per sfratto a ${esc(c.nome)}</span><span class="r-region">${esc(c.regione)}</span></a>`)
        .join('');
    }
  };

  searchInput?.addEventListener('input', render);
  regionFilter?.addEventListener('change', render);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (regionFilter) regionFilter.value = '';
    render();
    searchInput?.focus();
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const city = chip.getAttribute('data-city-chip') || '';
      if (searchInput) searchInput.value = city;
      if (regionFilter) regionFilter.value = '';
      render();
      panel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  render();
</script>
