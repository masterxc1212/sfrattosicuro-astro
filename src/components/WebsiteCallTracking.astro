---
/**
 * WebsiteCallTracking.astro
 * ------------------------------------------------------------------
 * Attiva il tracciamento "Chiamate dal sito web" di Google Ads:
 * per i visitatori provenienti dagli annunci, la libreria gtag
 * sostituisce il numero 02 8089 8395 con un NUMERO DI INOLTRO Google.
 * Quel numero inoltra automaticamente sul numero reale (mycentralino),
 * quindi il centralino continua a ricevere/registrare le chiamate come
 * prima, e Google conta la chiamata come conversione se dura >= 30s.
 *
 * Conversion action collegata: "Telefonate" (WEBSITE_CALL, primaria),
 * label tCrKCJeljvwYEM7bpvUo, numero visualizzato +39 02 80898395.
 *
 * Caricamento consent-gated:
 *  - il tag viene caricato subito se il consenso marketing e' gia' presente;
 *  - altrimenti parte appena l'utente accetta il marketing nel banner.
 *
 * Coordina con il loader inline delle landing tramite
 * window.__landingAdsLoaded per non caricare gtag due volte.
 */
const AW_ID = 'AW-10983419342';
const CALL_LABEL = 'tCrKCJeljvwYEM7bpvUo';   // conversion action "Telefonate" (Chiamate dal sito web)
// Formato NAZIONALE senza "+" (2026-09-05): con '+39 02 80898395' il test reale
// (click sull'annuncio) sostituiva il numero con "+02 8295 8803", cioe' lasciava
// il "+" davanti al numero d'inoltro nazionale — esattamente l'artefatto che la
// guida Google attribuisce al formato internazionale. Il testo in pagina deve
// coincidere carattere per carattere con questa stringa.
const PHONE_NUMBER = '02 80898395';           // numero visualizzato in pagina = numero mycentralino
// eager=true: bypassa il gate consenso (landing Ads allineate alla principale). Default false → sito organico invariato.
const { eager = false } = Astro.props;
---

<script is:inline define:vars={{ AW_ID, CALL_LABEL, PHONE_NUMBER, eager }}>
  (function () {
    var CONSENT_KEY = 'ss_cookie_consent_v1';

    function readConsent() {
      try {
        var raw = localStorage.getItem(CONSENT_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    }

    function ensureGtagLib() {
      window.dataLayer = window.dataLayer || [];
      if (typeof window.gtag !== 'function') {
        window.gtag = function () { window.dataLayer.push(arguments); };
      }
      if (!document.querySelector('script[data-aw-call], script[data-landing-aw], script[data-click-conv-aw]')) {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + AW_ID;
        s.setAttribute('data-aw-call', '1');
        document.head.appendChild(s);
      }
    }

    function initCallTracking(consent) {
      if (!consent || !consent.marketing) return;
      ensureGtagLib();
      if (!window.__landingAdsLoaded) {
        window.__landingAdsLoaded = true;
        window.gtag('consent', 'default', {
          ad_storage:         'granted',
          ad_user_data:       'granted',
          ad_personalization: 'granted',
          analytics_storage:  consent.analytics ? 'granted' : 'denied',
          security_storage:   'granted'
        });
        window.gtag('js', new Date());
        // Niente `send_page_view: false` (2026-08-11): su una destinazione AW,
        // dopo il config di GA4, sopprime la page_view automatica dell'intera
        // pagina. Era il terzo punto in cui compariva lo stesso flag.
        window.gtag('config', AW_ID, { transport_type: 'beacon' });
      }
      if (!window.__awPhoneConfigured) {
        window.__awPhoneConfigured = true;
        // ⚠️ NOTA CORRETTA IL 2026-08-25 — la spiegazione precedente era sbagliata.
        // Diceva: "senza country_code gtag manda cc=ZZ e Google non assegna mai il
        // numero d'inoltro -> WEBSITE_CALL sempre 0 (bug 2026-07-20)".
        // Verificato in produzione: gtag manda `cc=ZZ` al wcm COMUNQUE, sia col numero
        // in formato internazionale sia in formato nazionale, e sia con questo
        // country_code impostato sia senza. Il parametro non finisce nella richiesta.
        // E soprattutto: le conversioni WEBSITE_CALL registrate sono del **3 luglio**
        // (PRIMA del presunto fix) e del **28 luglio** (dopo) — quindi il meccanismo
        // funziona CON cc=ZZ e quel parametro non e' mai stato il blocco.
        // Si lascia il country_code perche' e' corretto dichiararlo e non fa danno,
        // ma NON aspettarsi che cambi `cc`: non e' li' il problema.
        // Il vero limite e' strutturale: la sostituzione del numero vale solo per chi
        // arriva da un annuncio, chiama dallo stesso dispositivo/sessione e compone il
        // numero sostituito. Per uno sfratto — dove si chiama dopo aver riflettuto,
        // spesso da un altro telefono — e' una minoranza dei casi.
        window.gtag('config', AW_ID + '/' + CALL_LABEL, {
          phone_conversion_number: PHONE_NUMBER,
          phone_conversion_country_code: 'IT'
        });
        armForwardingCallback();
      }
    }

    // 2026-09-05 — Test reale (click sull'annuncio): Google sostituiva SOLO i link il cui
    // testo contiene il numero. I bottoni "Chiama" (header mobile) e "Chiama ora" (sticky
    // mobile) restavano su tel:+390280898395 → chiamate dai bottoni principali su mobile
    // MAI attribuite. Con _googWcmGet(callback, numero) riceviamo il numero d'inoltro e lo
    // applichiamo a TUTTI i link tel: della pagina.
    // Il loader wcm attuale NON espone piu' `_googWcmGet` (verificato 2026-09-05: esistono solo
    // `_googWcmImpl`/`_googCallTrackingImpl`, entrambi opachi). Strategia indipendente dall'API:
    // Google riscrive da solo i link tel: il cui TESTO contiene il numero; noi leggiamo l'href
    // gia' riscritto e lo propaghiamo ai link tel: rimasti sul numero reale.
    var BUSINESS_DIGITS = PHONE_NUMBER.replace(/\D/g, '');   // '0280898395'
    function isBusiness(href) {
      var d = (href || '').replace(/\D/g, '');
      return d === BUSINESS_DIGITS || d === '39' + BUSINESS_DIGITS;
    }
    function propagateForwardingNumber() {
      var links = document.querySelectorAll('a[href^="tel:"]');
      var swapped = null;
      for (var i = 0; i < links.length; i++) {
        var h = links[i].getAttribute('href');
        if (h && !isBusiness(h) && h.replace(/\D/g, '').length >= 9) { swapped = h; break; }
      }
      if (!swapped) return false;
      for (var j = 0; j < links.length; j++) {
        if (isBusiness(links[j].getAttribute('href'))) {
          links[j].setAttribute('href', swapped);
          links[j].setAttribute('data-gfn', '1');
        }
      }
      return true;
    }
    function armForwardingCallback() {
      var tries = 0;
      var timer = setInterval(function () {
        tries += 1;
        if (propagateForwardingNumber() || tries > 60) clearInterval(timer); // max ~15 s
      }, 250);
    }

    initCallTracking(eager ? { marketing: true, analytics: true } : readConsent());

    window.addEventListener('ss:cookie-consent-updated', function (event) {
      var d = (event && event.detail) || {};
      if (d.marketing) initCallTracking(d);
    });
  })();
</script>
