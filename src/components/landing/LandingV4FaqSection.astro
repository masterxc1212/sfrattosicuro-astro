---
import { landingOriginal } from '../../data/landing-original';
import { pricing } from '../../lib/business';
import LandingOriginalFaqSection from './LandingOriginalFaqSection.astro';

const formatEuro = (value: number) =>
  new Intl.NumberFormat('it-IT', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  }).format(value);

const convalida = formatEuro(pricing.testV4.faseConvalida);
const esecuzione = formatEuro(pricing.testV4.faseEsecutiva);
const completa = formatEuro(pricing.compensoComplessivo);

const faqSection = {
  ...landingOriginal.faq,
  title: 'Le domande decisive prima di scegliere',
  subtitle: 'Cosa cambia tra formula completa e percorso per fasi.',
  subtitle2: '',
  items: [
    {
      icon: 'fa-layer-group',
      q: 'Qual è la differenza tra le tre formule?',
      a: `La fase di convalida costa <strong>${convalida}</strong>. Se dopo la convalida l'immobile non viene rilasciato, puoi attivare la fase esecutiva a <strong>${esecuzione}</strong>. La formula completa costa <strong>${completa}</strong> e comprende entrambe le fasi fino alla riconsegna delle chiavi.`,
    },
    {
      icon: 'fa-piggy-bank',
      q: 'Perché la formula completa costa meno delle due fasi?',
      a: `Le due fasi separate arrivano complessivamente a <strong>${formatEuro(pricing.testV4.faseConvalida + pricing.testV4.faseEsecutiva)}</strong>. Scegliendo subito la formula completa a <strong>${completa}</strong>, il risparmio è di <strong>${formatEuro(pricing.testV4.faseConvalida + pricing.testV4.faseEsecutiva - pricing.compensoComplessivo)}</strong>.`,
    },
    {
      icon: 'fa-calendar-check',
      q: 'Quando si paga la fase di convalida?',
      a: `Non chiediamo acconti per avviare la procedura. Il compenso della convalida è dovuto <strong>dopo l'udienza, qualunque ne sia l'esito</strong>.`,
    },
    {
      icon: 'fa-key',
      q: 'Se l’inquilino lascia l’immobile dopo la convalida?',
      a: `Nel percorso per fasi non serve attivare la fase esecutiva. Se hai scelto la formula completa, resta valido il compenso complessivo concordato per la disponibilità dell'assistenza fino alle chiavi.`,
    },
    {
      icon: 'fa-receipt',
      q: 'Gli importi comprendono tutto?',
      a: `Gli importi indicati sono <strong>IVA e cassa incluse</strong>. Restano escluse le spese vive di legge, comunicate prima. L'eventuale giudizio di merito successivo a un'opposizione richiede un preventivo scritto separato.`,
    },
    {
      icon: 'fa-clock',
      q: 'Quanto tempo richiede la convalida?',
      a: `In media circa 60 giorni. È un dato operativo, non una promessa assoluta: i tempi dipendono dal Tribunale competente e dall'eventuale opposizione dell'inquilino.`,
    },
  ],
  bottomTitle: 'Non sai quale formula scegliere?',
  bottomBody: 'Descrivici il caso: la prima valutazione è gratuita e non ti vincola.',
  ctaLabel: 'Richiedi la valutazione',
  ctaCaption: 'Solo proprietari e locatori · Nessun impegno',
};
---
<LandingOriginalFaqSection faqSection={faqSection} />
