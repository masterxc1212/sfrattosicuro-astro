---
import '../../styles/landing.css';
import { buildLandingPageConfig } from '../../data/landing-config';
import { versionedSrc } from '../../lib/asset-version';
import GA4TrackingIsland from '../../components/GA4TrackingIsland.astro';
import ClickConversionTracking from '../../components/ClickConversionTracking.astro';
import WebsiteCallTracking from '../../components/WebsiteCallTracking.astro';
import MetaPixelTracking from '../../components/MetaPixelTracking.astro';
import LandingExperimentTracking from '../../components/LandingExperimentTracking.astro';
import { pricing } from '../../lib/business';

import LandingOriginalHeaderSection from '../../components/landing/LandingOriginalHeaderSection.astro';
import LandingOriginalHeroSection from '../../components/landing/LandingOriginalHeroSection.astro';
import LandingOriginalReviewsSection from '../../components/landing/LandingOriginalReviewsSection.astro';
import LandingOriginalProvvedimentiSection from '../../components/landing/LandingOriginalProvvedimentiSection.astro';
import LandingOriginalProcedureSection from '../../components/landing/LandingOriginalProcedureSection.astro';
import LandingOriginalFaqSection from '../../components/landing/LandingOriginalFaqSection.astro';
import LandingV3PriceSection from '../../components/landing/LandingV3PriceSection.astro';
import LandingV4PricingSection from '../../components/landing/LandingV4PricingSection.astro';
import LandingV4FaqSection from '../../components/landing/LandingV4FaqSection.astro';
import LandingV3ContactSection from '../../components/landing/LandingV3ContactSection.astro';
import LandingV3FounderSection from '../../components/landing/LandingV3FounderSection.astro';
import LandingOriginalFooterSection from '../../components/landing/LandingOriginalFooterSection.astro';
import LandingAugustNoticeSection from '../../components/landing/LandingAugustNoticeSection.astro';
import { formatBusinessEuro } from '../../lib/business';

interface Props {
  variant?: 'v3' | 'v4';
  campaign?: 'standard' | 'august2026';
}

const { variant = 'v3', campaign = 'standard' } = Astro.props;
const isV4 = variant === 'v4';
const isAugust = campaign === 'august2026';
const augustPromo = pricing.promozioni.agosto2026;
const augustPrice = formatBusinessEuro(augustPromo.compensoComplessivo);
const regularPrice = formatBusinessEuro(pricing.compensoComplessivo);

const baseConfig = buildLandingPageConfig({
  version: variant,
  territory: 'nazionale',
  keyword: 'sfratto-per-morosita',
});

const augustDescription = `Studio aperto tutto agosto. Procedimenti per convalida di sfratto esclusi dalla sospensione feriale dei termini. ${augustPrice} invece di ${regularPrice} per mandati sottoscritti entro il 31 agosto 2026.`;
const replaceAugustPrice = (text: string) => text
  .replace(/€1\.300/g, augustPrice)
  .replace(/1\.300€/g, `${augustPrice.replace('€', '')}€`);
const augustFaqItems = [
  {
    icon: 'fa-calendar-check',
    q: 'Posso avviare uno sfratto durante il mese di agosto?',
    a: 'Sì. La fase sommaria di convalida dello sfratto è sottratta alla sospensione feriale dei termini (art. 3 della legge 7 ottobre 1969 n. 742, in relazione all’art. 92 del R.D. 30 gennaio 1941 n. 12): in quella fase i termini non restano sospesi e lo Studio resta operativo tutto agosto. Se però l’inquilino si oppone e il giudizio prosegue nelle forme del rito ordinario, alla fase successiva la sospensione feriale si applica. La data concreta dell’udienza e l’organizzazione dei singoli uffici dipendono in ogni caso dal Tribunale competente.',
  },
  {
    icon: 'fa-tag',
    q: `Come si ottiene la tariffa di agosto a ${augustPrice}?`,
    a: `La tariffa di ${augustPrice}, IVA e cassa incluse, si applica se il mandato professionale viene sottoscritto entro il 31 agosto 2026. Comprende lo stesso servizio della formula V3 ordinaria: convalida e, se necessaria, fase esecutiva fino alla riconsegna delle chiavi. Restano escluse le spese vive di legge e l’eventuale giudizio di merito in caso di opposizione.`,
  },
  ...baseConfig.faq.items.map((item) => ({
    ...item,
    q: replaceAugustPrice(item.q),
    a: replaceAugustPrice(item.a),
  })),
];
const config = isAugust ? {
  ...baseConfig,
  seo: {
    ...baseConfig.seo,
    title: `Avvocato per Sfratto ad Agosto | ${augustPrice} fino al rilascio`,
    description: augustDescription,
    canonicalUrl: 'https://www.sfrattosicuro.it/landing-v3-agosto/',
    ogTitle: `Sfratto ad agosto: studio aperto, tariffa ${augustPrice}`,
    ogDescription: augustDescription,
    ogUrl: 'https://www.sfrattosicuro.it/landing-v3-agosto/',
    twitterTitle: `Sfratto ad agosto: studio aperto, tariffa ${augustPrice}`,
    twitterDescription: augustDescription,
  },
  hero: {
    ...baseConfig.hero,
    title: 'Sfratto ad agosto: lo Studio resta aperto',
    subtitle: `I procedimenti per convalida di sfratto sono esclusi dalla sospensione feriale dei termini. <strong class="text-white">Avviamo la pratica anche ad agosto</strong>, in tutta Italia.`,
    bullets: [
      `<strong>${augustPrice} invece di ${regularPrice}</strong> per il mandato firmato entro il 31 agosto`,
      '<strong>Studio operativo tutto il mese di agosto</strong>',
      '<strong>Convalida di sfratto esclusa</strong> dalla sospensione feriale dei termini',
      '<strong>Zero anticipi</strong>: paghi solo dopo l’udienza',
      '<strong>Convalida + fase esecutiva</strong>, fino alla riconsegna delle chiavi',
    ],
    formTitle: 'Blocca la tariffa di agosto',
    formSubtitle: 'Prima valutazione <strong>gratuita e senza impegno</strong>. La tariffa si applica al mandato sottoscritto entro il 31 agosto 2026.',
    formSource: 'hero_form_v3_agosto',
  },
  faq: {
    ...baseConfig.faq,
    title: 'Agosto, tariffa e procedura: risposte chiare',
    subtitle: 'Cosa cambia davvero nel mese di agosto e quali condizioni si applicano.',
    items: augustFaqItems,
  },
  jsonLd: {
    ...baseConfig.jsonLd,
    legalService: {
      ...baseConfig.jsonLd.legalService,
      description: augustDescription,
      url: 'https://www.sfrattosicuro.it/landing-v3-agosto/',
      priceRange: augustPrice,
    },
    organization: {
      ...baseConfig.jsonLd.organization,
      url: 'https://www.sfrattosicuro.it/landing-v3-agosto/',
    },
    website: {
      ...baseConfig.jsonLd.website,
      url: 'https://www.sfrattosicuro.it/landing-v3-agosto/',
    },
    faq: {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: augustFaqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a.replace(/<[^>]+>/g, ''),
        },
      })),
    },
  },
} : baseConfig;
---
<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/assets/icons/favicon-96x96.png" sizes="96x96">
    <link rel="shortcut icon" href="/assets/icons/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="Sfratto">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#1B2951">
    <title>{config.seo.title}</title>
    <meta name="description" content={config.seo.description}>
    <meta name="keywords" content={config.seo.keywords}>
    <meta name="robots" content={config.seo.robots}>
    <meta name="author" content="SfrattoSicuro.it">
    <link rel="canonical" href={config.seo.canonicalUrl}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={config.seo.ogTitle}>
    <meta property="og:description" content={config.seo.ogDescription}>
    <meta property="og:url" content={config.seo.ogUrl}>
    <meta property="og:site_name" content="SfrattoSicuro.it">
    <meta property="og:locale" content="it_IT">
    <meta property="og:image" content="https://www.sfrattosicuro.it/assets/img/hero.webp">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={config.seo.twitterTitle}>
    <meta name="twitter:description" content={config.seo.twitterDescription}>
    <meta name="twitter:image" content="https://www.sfrattosicuro.it/assets/img/hero.webp">
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="dns-prefetch" href="//www.google-analytics.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
    <script type="application/ld+json" set:html={JSON.stringify(config.jsonLd.legalService)} />
    <script type="application/ld+json" set:html={JSON.stringify(config.jsonLd.organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(config.jsonLd.website)} />
    {!isV4 && <script type="application/ld+json" set:html={JSON.stringify(config.jsonLd.faq)} />}
    <script>
      (function(){
        const CONSENT_KEY = 'ss_cookie_consent_v1';
        const AW_ID = 'AW-10983419342';
        function getParam(name){
          const params = new URLSearchParams(window.location.search);
          return params.get(name) || sessionStorage.getItem(name) || '';
        }
        function captureTrackingParams(){
          const gclid = getParam('gclid');
          const utmSource = getParam('utm_source');
          const utmMedium = getParam('utm_medium');
          const utmCampaign = getParam('utm_campaign');
          const utmTerm = getParam('utm_term');
          const utmContent = getParam('utm_content');
          const keyword = getParam('keyword');
          const matchtype = getParam('matchtype');
          document.querySelectorAll('form[action="/php/invia-email.php"]').forEach(function(f){
            var set = function(n, v){ var i = f.querySelector('[name="'+n+'"]'); if(i) i.value = v; };
            set('gclid', gclid); set('utm_source', utmSource); set('utm_medium', utmMedium); set('utm_campaign', utmCampaign); set('utm_term', utmTerm); set('utm_content', utmContent); set('keyword', keyword); set('matchtype', matchtype);
          });
        }
        function readConsent(){ try { const raw = localStorage.getItem(CONSENT_KEY); return raw ? JSON.parse(raw) : null; } catch { return null; } }
        function initAdsIfNeeded(consent){
          if (!consent?.marketing) return;
          if (window.__landingAdsLoaded) return;
          window.__landingAdsLoaded = true;
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = window.gtag || gtag;
          window.gtag('consent', 'default', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' });
          window.gtag('js', new Date());
          window.gtag('config', AW_ID, { send_page_view: false, transport_type: 'beacon' });
          if (!document.querySelector('script[data-landing-aw="' + AW_ID + '"]')) {
            var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + AW_ID; s.setAttribute('data-landing-aw', AW_ID); document.head.appendChild(s);
          }
        }
        // Applica al DOM quando è pronto (la call diretta è in <head>, form non ancora nel DOM)
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', captureTrackingParams, { once: true });
        } else {
          captureTrackingParams();
        }
        // Belt-and-suspenders: ri-applica al submit (copre form dinamici)
        document.addEventListener('submit', function(ev) {
          if (ev.target && ev.target.matches && ev.target.matches('form[action="/php/invia-email.php"]')) {
            captureTrackingParams();
          }
        }, true);
        // Allineata alla landing principale: tag Ads EAGER, senza gate consenso (decisione utente 2026-07-16).
        // Così il gclid viene salvato nel cookie e le conversioni (modulo su grazie, WhatsApp, telefono) si attribuiscono.
        initAdsIfNeeded({ marketing: true });
      })();
    </script>
  </head>
  <body class:list={['landing-v3-body', { 'landing-v4-body': isV4 }]}>
    <LandingOriginalHeaderSection />
    <main id="main-content" class="landing-v3-main" style="min-height:100vh; margin-top: var(--header-h, 90px);">
      {isAugust && <LandingAugustNoticeSection />}
      <LandingOriginalHeroSection
        hero={config.hero}
        augustPromotion={isAugust ? { price: augustPrice, regularPrice, validThrough: '31 agosto 2026' } : undefined}
      />
      <LandingOriginalProcedureSection procedure={config.procedure} />
      {isV4 ? <LandingV4PricingSection /> : <LandingV3PriceSection isAugust={isAugust} />}
      <LandingOriginalReviewsSection />
      <LandingOriginalProvvedimentiSection />
      <LandingV3FounderSection />
      {isV4 ? <LandingV4FaqSection /> : <LandingOriginalFaqSection faqSection={config.faq} />}
      <LandingV3ContactSection contactForm={config.contactForm} formSource={isV4 ? 'bottom_form_v4' : isAugust ? 'bottom_form_v3_agosto' : 'bottom_form_v3'} />
    </main>

    <!-- Sticky CTA mobile (social proof + richiamata) -->
    <div class="landing-v3-sticky-cta">
      <a href="tel:+390280898395" class="landing-v3-sticky-btn is-call"><i class="fas fa-phone" aria-hidden="true"></i> Chiama ora</a>
      <a href="#form-rapido" class="landing-v3-sticky-btn is-form"><i class="fas fa-pen" aria-hidden="true"></i> Lascia il numero</a>
    </div>
    <LandingOriginalFooterSection />
    <GA4TrackingIsland measurementId="G-509YE5HCYB" eager />
    <ClickConversionTracking eager />
    <WebsiteCallTracking eager />
    <MetaPixelTracking pixelId="1373903100373659" />
    <LandingExperimentTracking experimentId={pricing.testV4.experimentId} variant={variant} />
    <script src={versionedSrc('/assets/js/reviews.js')} defer></script>
    <script src={versionedSrc('/assets/js/form-validation.js')} defer></script>
    <script src={versionedSrc('/assets/js/main.js')} defer></script>
    <script is:inline>
      (function(){
        // Fuori orario (R7 commissione 2): il tap "Chiama ora" a studio chiuso squilla a vuoto.
        // Lun-Ven 9-19, Sab 9-13 (Europe/Rome): fuori da queste fasce la sticky-call diventa
        // un'ancora al form e il bottone-form dedicato si nasconde (sarebbe un doppione).
        try {
          var parts = new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', hour: 'numeric', weekday: 'short', hour12: false }).formatToParts(new Date());
          var h = parseInt((parts.find(function(p){ return p.type === 'hour'; }) || {}).value, 10);
          var wd = ((parts.find(function(p){ return p.type === 'weekday'; }) || {}).value || '').toLowerCase().slice(0, 3);
          var feriale = ['lun','mar','mer','gio','ven'].indexOf(wd) > -1;
          var open = (feriale && h >= 9 && h < 19) || (wd === 'sab' && h >= 9 && h < 13);
          if (!open) {
            var call = document.querySelector('.landing-v3-sticky-btn.is-call');
            var formBtn = document.querySelector('.landing-v3-sticky-btn.is-form');
            if (call) {
              call.setAttribute('href', '#form-rapido');
              call.innerHTML = '<i class="fas fa-phone" aria-hidden="true"></i> Chiusi ora: lascia il numero';
              call.classList.add('is-closed');
            }
            if (formBtn) formBtn.style.display = 'none';
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      (function(){
        // Eventi funnel GA4 (blocco A11 commissione): misura dove si perde l'utente.
        function ev(name, params){ if (typeof window.gtag === 'function') window.gtag('event', name, params || {}); }
        var formStarted = false;
        document.addEventListener('focusin', function(e){
          if (formStarted) return;
          var f = e.target && e.target.closest && e.target.closest('form[action="/php/invia-email.php"]');
          if (!f) return;
          formStarted = true;
          ev('form_start', { form_id: f.id || (f.querySelector('[name=form_source]')||{}).value || '' });
        });
        document.addEventListener('submit', function(e){
          var f = e.target;
          if (!f || !f.matches || !f.matches('form[action="/php/invia-email.php"]')) return;
          ev('submit_attempt', { form_id: f.id || '' });
        }, true);
        document.addEventListener('invalid', function(e){
          var el = e.target, f = el && el.form;
          if (!f || !f.matches || !f.matches('form[action="/php/invia-email.php"]')) return;
          ev('submit_blocked', { form_id: f.id || '', field: el.name || el.id || '', reason: (el.validationMessage || '').slice(0, 80) });
        }, true);
        document.addEventListener('click', function(e){
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var h = (a.getAttribute('href') || '').toLowerCase();
          var kind = h.indexOf('tel:') === 0 ? 'tel' : ((h.indexOf('wa.me') > -1 || h.indexOf('whatsapp') > -1) ? 'whatsapp' : null);
          if (!kind) return;
          ev('cta_click', { channel: kind, position: (a.className || '').toString().split(' ')[0].slice(0, 40) });
        }, true);
      })();
    </script>
    <script is:inline>
      (function(){
        // Qualificazione v3: blocca invio se inquilino o se manca la scelta proprietario/inquilino.
        document.addEventListener('submit', function(ev){
          var f = ev.target;
          if (!f || !f.matches || !f.matches('form[action="/php/invia-email.php"]')) return;
          var sel = f.querySelector('select[name="proprietario"]');
          if (!sel) return;
          if (!sel.value) {
            ev.preventDefault(); ev.stopImmediatePropagation();
            alert('Indica se sei proprietario/locatore oppure inquilino.');
            sel.focus();
            return;
          }
          if (sel.value === 'inquilino') {
            ev.preventDefault(); ev.stopImmediatePropagation();
            alert('Questo servizio è riservato ai proprietari e ai locatori. Non assistiamo inquilini.');
          }
        }, true);
      })();
    </script>
  </body>
</html>
