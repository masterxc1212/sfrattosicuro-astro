---
// LandingOriginalHeroSection.astro — 1:1 clone of original hero
// Source: public/landing/index.html
import { landingOriginal } from '../../data/landing-original';
import { socialProof } from '../../lib/business';

interface Props {
  hero?: typeof landingOriginal.hero;
  redirectUrl?: string;
  augustPromotion?: {
    price: string;
    regularPrice: string;
    validThrough: string;
  };
}

const { hero = landingOriginal.hero, redirectUrl = '/grazie.html', augustPromotion } = Astro.props;
const bulletDetails: string[] | undefined = (hero as any).bulletDetails;
const googleReviewsTotal = socialProof.googleReviewsTotal;
---
<section
  class="hero-section text-white relative overflow-hidden"
  style="background: linear-gradient(135deg, #1B2951 0%, #2a4073 50%, #1B2951 100%);"
  aria-label="Sezione principale"
>
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="hero-grid landing-v3-hero-grid">

        <div class="hero-content landing-v3-hero-content">

          {augustPromotion && (
            <p class="landing-v3-august-badge">
              <span aria-hidden="true">●</span>
              Aperti tutto agosto · tariffa valida fino al {augustPromotion.validThrough}
            </p>
          )}

          <div class="hero-seal-mobile lg:hidden">
            <picture>
              <source media="(min-width: 1024px)" srcset="/assets/img/sigillo/sigillo-315.webp" width="315" height="315">
              <source media="(min-width: 640px)" srcset="/assets/img/sigillo/sigillo-240.webp" width="240" height="240">
              <img
                src="/assets/img/sigillo/sigillo-180.webp"
                alt="Avvocati Iscritti all'Albo Professionisti"
                class="seal-prominent-img"
                width="180"
                height="180"
                fetchpriority="high"
                decoding="async"
                loading="eager"
              >
            </picture>
          </div>

          <h1 class="hero-title landing-v3-hero-title" set:html={hero.title.replace(/\n/g, '<br>')}></h1>

          <h2 class="hero-subtitle landing-v3-hero-subtitle" set:html={hero.subtitle}></h2>

          {hero.formTrustLine && (
            <p class="landing-v3-mobile-proof">
              <strong>Avv. Danilo Ansalone</strong>
              <span aria-hidden="true">·</span>
              Solo sfratti dal 2018
              <span aria-hidden="true">·</span>
              <span class="landing-v3-mobile-proof-rating">
                <span aria-hidden="true">★</span> <span data-live-rating>5.0</span> su Google
              </span>
            </p>
          )}

          {hero.prequalificationNote && (
            <div class="inline-block landing-v3-prequal bg-white/10 border border-white/20 rounded-lg px-4 py-3 mb-4 text-sm font-semibold backdrop-blur-sm">
              <span set:html={hero.prequalificationNote}></span>
            </div>
          )}

          <ul class="hero-benefits landing-v3-hero-benefits">
            {hero.bullets.map((bullet, i) => (
              <li class="hero-benefit-item">
                <span class="checkmark" aria-hidden="true">✓</span>
                {bulletDetails && bulletDetails[i] ? (
                  <span class="ss-toggle-wrap">
                    <button type="button" class="ss-toggle" aria-expanded="false" aria-controls={`hero-bullet-more-${i}`}>
                      <span set:html={bullet}></span>
                      <span class="ss-toggle-caret" aria-hidden="true">+</span>
                    </button>
                    <span id={`hero-bullet-more-${i}`} class="ss-toggle-more" hidden>{bulletDetails[i]}</span>
                  </span>
                ) : (
                  <span set:html={bullet}></span>
                )}
              </li>
            ))}
          </ul>

        </div>

        <div class="hero-form-container landing-v3-hero-form-wrap">
          {hero.formTrustLine && (
            <div class="landing-v3-offer-strip lg:hidden" aria-hidden="false">
              <div class="landing-v3-offer-strip-l1">
                {augustPromotion ? (
                  <>Agosto: <s>{augustPromotion.regularPrice}</s> <strong>{augustPromotion.price} fino alle chiavi</strong></>
                ) : (
                  <>Sfratto: <strong>€1.300 chiavi in mano</strong>, convalida + esecuzione</>
                )}
              </div>
              <div class="landing-v3-offer-strip-l2">Zero anticipi · IVA e cassa incluse · <span class="landing-v3-offer-star" aria-hidden="true">★</span> <strong><span data-live-rating>5.0</span></strong> su Google (<span data-live-total>{googleReviewsTotal}</span>)</div>
            </div>
          )}
          <div class="hero-form-card landing-v3-hero-form-card">
            <div class="text-center landing-v3-form-head">
              <h3 class="form-title">{hero.formTitle}</h3>
              <p class="form-subtitle" set:html={hero.formSubtitle}></p>
            </div>

            <form
              action="/php/invia-email.php"
              method="POST"
              id="hero-form"
            >
              <div class="form-group">
                <label for="telefono-hero" class="form-label">Telefono *</label>
                <input
                  type="tel"
                  name="telefono"
                  id="telefono-hero"
                  class="form-input"
                  placeholder={hero.formPhonePlaceholder}
                  inputmode="tel"
                  minlength="8"
                  required
                  aria-required="true"
                  autocomplete="tel"
                >
              </div>

              <div class="form-group">
                <label for="email-hero" class="form-label">Email *</label>
                <input type="email" name="email" id="email-hero" class="form-input"
                       placeholder="Per inviarti l’accesso alla tua pratica" autocomplete="email" inputmode="email" required aria-required="true">
              </div>

              <p class="hero-form-owners">Servizio riservato a proprietari e locatori.</p>

              <input type="hidden" name="nome" value="">
              <input type="hidden" name="form_source" value={hero.formSource}>
              <input type="hidden" name="gclid" value="">
              <input type="hidden" name="utm_source" value="">
              <input type="hidden" name="utm_medium" value="">
              <input type="hidden" name="utm_campaign" value="">
              <input type="hidden" name="utm_term" value="">
              <input type="hidden" name="keyword" value="">
              <input type="hidden" name="utm_content" value="">
              <input type="hidden" name="matchtype" value="">
              <input type="hidden" name="redirect_url" value={redirectUrl}>

              <button type="submit" class="form-submit" aria-label="Invia la richiesta di consulenza gratuita">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                <span>{hero.formSubmitLabel}</span>
              </button>

              {hero.formTrustLine && (
                <p class="hero-form-hours">Ti richiamiamo entro 2 ore lavorative · Lun–Ven 9–19 · Sab 9–13</p>
              )}

              {hero.formTrustLine && (
                <a href="tel:+390280898395" class="hero-call-cta" aria-label="Chiama ora lo studio">
                  <i class="fas fa-phone" aria-hidden="true"></i>
                  <span>Chiama ora: <strong>02 80898395</strong></span>
                </a>
              )}

              {hero.formTrustLine && (
                <>
                  <p class="hero-form-trust">
                    <span class="hero-form-stars" aria-hidden="true">★★★★★</span>
                    <strong><span data-live-rating>5.0</span></strong> su Google
                    · <span data-live-total>{googleReviewsTotal}</span> recensioni · Dati protetti
                  </p>
                  <p class="hero-form-whocalls">
                    Ti richiama lo studio dell'Avv. Ansalone dal numero <strong>02 80898395</strong>: salvalo in rubrica. Nessun call center.
                  </p>
                  <p class="hero-form-privacy">
                    Inviando accetti la <a href="/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>. I tuoi dati non verranno condivisi.
                  </p>
                </>
              )}
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .landing-v3-august-badge {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin: 0 0 .9rem;
    padding: .52rem .75rem;
    border: 1px solid rgba(244,232,200,.45);
    border-radius: 999px;
    background: rgba(244,232,200,.12);
    color: #f4e8c8;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .03em;
    text-transform: uppercase;
  }
  .landing-v3-august-badge span { color: #59c67a; }
  .landing-v3-offer-strip s { color: rgba(255,255,255,.7); margin-right: .25rem; }
  @media (max-width: 640px) {
    .landing-v3-august-badge { font-size: .68rem; line-height: 1.3; text-align: left; }
  }
</style>
