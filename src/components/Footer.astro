              </a></li>
            )}
            {social.tiktok && (
              <li><a href={social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="Sfratto Sicuro su TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.01-2.82h-3.3v12.96a2.59 2.59 0 1 1-2.59-2.59c.27 0 .52.04.77.11V9.95a5.88 5.88 0 0 0-.77-.05A5.88 5.88 0 1 0 15.6 15.8V9.4a7.55 7.55 0 0 0 4.4 1.41V7.5a4.28 4.28 0 0 1-3.4-1.68z"/></svg>
              </a></li>
