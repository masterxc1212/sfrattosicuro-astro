            {social.linkedin && (
              <li><a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Sfratto Sicuro su LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              </a></li>
            )}
          </ul>
        )}
        <p class="muted small legal-links">
          <a href="/privacy-policy/">Privacy Policy</a> ·
          <a href="/termini/">Termini</a> ·
          <a href="/cookie-policy/">Cookie Policy</a>
        </p>
      </div>

      <div>
        <h3>Servizi</h3>
        <ul>
          <li><a href="/servizi/sfratto-per-morosita/">Sfratto per Morosità</a></li>
          <li><a href="/servizi/sfratto-per-finita-locazione/">Sfratto per Finita Locazione</a></li>
          <li><a href="/servizi/recupero-canoni-non-pagati/">Recupero Canoni</a></li>
          <li><a href="/servizi/controversie-locazione/">Controversie Locazione</a></li>
        </ul>
        <h3>Approfondimenti</h3>
        <ul>
          <li><a href="/blog/">Blog su sfratti e locazioni</a></li>
          <li><a href="/chi-siamo/">Chi siamo</a></li>
          <li><a href="/sedi/">Sedi territoriali</a></li>
        </ul>
      </div>

      <div>
        <h3>Dove Operiamo</h3>
        <div class="where-card">
          <p class="where-title">{sedeLabel}</p>
          <p class="where-line"><strong>Tribunale:</strong> {tribunale}</p>
          <p class="where-line"><strong>Area:</strong> {sedeLocalita}</p>
          <p class="where-line"><strong>Indirizzo:</strong> {sedeAddress}</p>
          {coperturaText && <p class="where-note">{coperturaText}</p>}
        </div>
      </div>

      <div>
        <h3>Dati Societari</h3>
        <p class="strong">© {new Date().getFullYear()} Sfratto Sicuro</p>
        <p>{legalName}</p>
        <p class="muted small">P. IVA {vatId}</p>
        <p class="muted small">E-mail: <a href={`mailto:${legalEmail}`}>{legalEmail}</a></p>
        <p class="muted small">Telefono: <a href={`tel:${legalPhone.replace(/\s+/g, '')}`}>{legalPhone}</a></p>
        <p class="muted small">Capitale Sociale Interamente Versato</p>
      </div>
    </div>
  </div>
</footer>

