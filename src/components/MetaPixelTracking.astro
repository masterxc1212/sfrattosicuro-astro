---
/**
 * MetaPixelTracking.astro — Meta (Facebook) Pixel consent-gated + eventi.
 *
 * Carica fbevents.js e invia eventi SOLO dopo consenso "marketing",
 * coerente con GA4TrackingIsland / Google Ads su questa landing
 * (chiave localStorage `ss_cookie_consent_v1`, evento `ss:cookie-consent-updated`).
 *
 * Eventi (speculari alle conversioni Google Ads della landing):
 *  - PageView            : sempre all'init
 *  - Contact {whatsapp}  : click su link wa.me / whatsapp  (= conversione "Click WhatsApp")
 *  - Contact {phone}     : click su link tel:              (lato web del telefono; in Google la
 *                          telefonata vera è contata via numero MyCentralino, non replicabile dal pixel)
 *  - Lead                : opzionale, via prop `leadOnLoad` (usato sulla pagina grazie)
 *
 * Pixel/dataset Meta "Sfratto Sicuro": 1373903100373659.
 */
interface Props {
  pixelId?: string;
  leadOnLoad?: boolean;
  /**
   * `eager` = carica senza attendere il consenso, come gia' fanno
   * GA4TrackingIsland / ClickConversionTracking / WebsiteCallTracking sulle landing.
   * Aggiunto il 2026-08-11: sulle landing il pixel era l'unico dei quattro montato
   * SENZA questa opzione, quindi restava in attesa di un consenso che su quelle
   * pagine non puo' arrivare (li' il banner non c'e'). In pratica non partiva mai,
   * salvo per chi aveva gia' accettato sul sito normale.
   */
  eager?: boolean;
  /** deferred = carica alla prima interazione o 3 s dopo il load (richiede window.__ssWhenEngaged). */
  deferred?: boolean;
}
const { pixelId = '1373903100373659', leadOnLoad = false, eager = false, deferred = false } = Astro.props;
---

<script is:inline define:vars={{ pixelId, leadOnLoad, eager, deferred }}>
  (() => {
    if (!pixelId) return;

    const CONSENT_KEY = 'ss_cookie_consent_v1';

    const readConsent = () => {
      try {
        const raw = localStorage.getItem(CONSENT_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    };

    const initPixelIfNeeded = (consent) => {
      if (!consent?.marketing) return;
      if (window.__metaPixelLoaded) return;
      window.__metaPixelLoaded = true;

      // Snippet base Meta Pixel (fbevents)
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      window.fbq('init', pixelId);
      window.fbq('track', 'PageView');
      if (leadOnLoad) window.fbq('track', 'Lead');
    };

    // Invia un evento solo se il pixel è attivo (consenso dato)
    const track = (eventName, params) => {
      if (!window.__metaPixelLoaded || typeof window.fbq !== 'function') return;
      window.fbq('track', eventName, params || {});
    };

    // Click su WhatsApp / telefono → Contact (mirror conversioni Google)
    const classify = (href) => {
      if (!href) return null;
      const h = href.toLowerCase();
      if (h.indexOf('wa.me') > -1 || h.indexOf('whatsapp') > -1) return 'whatsapp';
      if (h.indexOf('tel:') === 0) return 'phone';
      return null;
    };

    document.addEventListener('click', (ev) => {
      const a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
      if (!a) return;
      const method = classify(a.getAttribute('href'));
      if (!method) return;
      // anti-doppio-conteggio sullo stesso link
      if (a.__metaFiredAt && (Date.now() - a.__metaFiredAt) < 1500) return;
      a.__metaFiredAt = Date.now();
      track('Contact', { method });
    }, true);

    const consent = eager ? { marketing: true } : readConsent();
    if (consent?.marketing) {
      const run = () => initPixelIfNeeded(consent);
      if (deferred && typeof window.__ssWhenEngaged === 'function') window.__ssWhenEngaged(run); else run();
    }

    window.addEventListener('ss:cookie-consent-updated', (event) => {
      const detail = event?.detail || {};
      if (detail.marketing) initPixelIfNeeded(detail);
    });
  })();
</script>

<noscript>
  <img
    height="1"
    width="1"
    style="display:none"
    src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
  />
</noscript>
