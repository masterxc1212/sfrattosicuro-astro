---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import GA4TrackingIsland from '../components/GA4TrackingIsland.astro';
import GoogleAdsTagIsland from '../components/GoogleAdsTagIsland.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ClickConversionTracking from '../components/ClickConversionTracking.astro';
import WebsiteCallTracking from '../components/WebsiteCallTracking.astro';
import TikTokPixelTracking from '../components/TikTokPixelTracking.astro';
import MetaPixelTracking from '../components/MetaPixelTracking.astro';
import MetaAdvancedMatching from '../components/MetaAdvancedMatching.astro';
import AdAttributionFields from '../components/AdAttributionFields.astro';
import BehaviourTracking from '../components/BehaviourTracking.astro';
import ClarityTracking from '../components/ClarityTracking.astro';
import EngagedLoader from '../components/EngagedLoader.astro';
import { consentBannerEnabled, trackingEager, tiktokPixelId, clarityProjectId } from '../lib/tracking-config';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  image?: string;
  type?: 'website' | 'article';
  hideStickyMobileCta?: boolean;
}

const {
  title = 'Sfratto Sicuro',
  description = 'Sito ufficiale Sfratto Sicuro',
  canonicalPath,
  robots = 'index,follow',
  image,
  type = 'website',
  hideStickyMobileCta = false
} = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 2026-09-05 — Font self-hosted (Fraunces con asse SOFT + Plus Jakarta Sans, latin, variabili,
        @font-face in global.css). Prima: CSS di Google Fonts render-blocking (~840 ms nel lab mobile),
        JetBrains Mono mai usato (--font-mono ricade sul monospace di sistema). */}
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/plus-jakarta-sans-latin-var.woff2" crossorigin />
    {/* Fraunces (118 KB, asse SOFT usato dalle pull-quote) NON in preload: arriva dal CSS con swap, senza rubare banda al CSS. */}
    <EngagedLoader />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      robots={robots}
      image={image}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="ss-skip-link" href="#main-content">Vai al contenuto</a>
    <span class="grain" aria-hidden="true"></span>
    <slot />
    {!hideStickyMobileCta && <StickyMobileCTA />}
    {/* Banner e gate del consenso sono comandati da src/lib/tracking-config.ts.
        Nessun codice e' stato rimosso: con `consentBannerEnabled = true` tutto
        torna esattamente com'era. */}
    {consentBannerEnabled && <CookieConsentBanner />}
    {/* 2026-09-05: con `deferred` i tracker partono alla prima interazione (o 8 s dopo il load),
        vedi EngagedLoader. Lighthouse mobile prima: home 55, blog 53, sede 56. */}
    {/* Ads PRIMA di GA4: la libreria caricata con id AW- avvia anche il loader del numero d'inoltro (wcm);
        GA4 poi si appoggia alla stessa gtag.js (controllo generico in ogni island). */}
    <GoogleAdsTagIsland eager={trackingEager} deferred />
    <GA4TrackingIsland measurementId="G-509YE5HCYB" eager={trackingEager} deferred />
    <ClickConversionTracking eager={trackingEager} />
    <WebsiteCallTracking eager={trackingEager} />
    <TikTokPixelTracking pixelId={tiktokPixelId} eager={trackingEager} deferred />
    {/* Pixel Meta esteso a tutto il sito il 2026-08-14: prima viveva solo sulle
        landing, quindi home, blog e 137 pagine sede non alimentavano alcun
        pubblico di remarketing. Stessa lacuna gia' chiusa per Google Ads. */}
    <MetaPixelTracking eager={trackingEager} deferred />
    {/* Advanced Matching (email/telefono in SHA-256) aggiunto il 2026-08-22:
        l'EMQ del pixel era 6,1/10 perche' a Meta non arrivava alcun dato di
        contatto. Non tocca l'invio del modulo: gli hash si calcolano mentre
        l'utente digita. Vedi il componente per il dettaglio. */}
    <MetaAdvancedMatching />
    {/* Cattura GCLID/UTM su TUTTI i moduli. Aggiunto il 2026-08-22: il modulo di
        home e sedi non aveva nemmeno il campo nascosto `gclid`, quindi ogni lead
        nato li' arrivava in CRM senza attribuzione. Vedi il componente. */}
    <AdAttributionFields />
    <BehaviourTracking />
    <ClarityTracking projectId={clarityProjectId} eager={trackingEager} deferred />
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('[data-anim="fade-up"]').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduce) {
          document.querySelectorAll('[data-anim="fade-up"]').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-anim="fade-up"]').forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
