---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import GA4TrackingIsland from '../components/GA4TrackingIsland.astro';
import GoogleAdsTagIsland from '../components/GoogleAdsTagIsland.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ClickConversionTracking from '../components/ClickConversionTracking.astro';
import WebsiteCallTracking from '../components/WebsiteCallTracking.astro';
import TikTokPixelTracking from '../components/TikTokPixelTracking.astro';
import MetaPixelTracking from '../components/MetaPixelTracking.astro';
import BehaviourTracking from '../components/BehaviourTracking.astro';
import { consentBannerEnabled, trackingEager, tiktokPixelId } from '../lib/tracking-config';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  image?: string;
  type?: 'website' | 'article';
  hideStickyMobileCta?: boolean;
}

const {
  title = 'Sfratto Sicuro',
  description = 'Sito ufficiale Sfratto Sicuro',
  canonicalPath,
  robots = 'index,follow',
  image,
  type = 'website',
  hideStickyMobileCta = false
} = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Google Fonts — Fraunces (display) + Plus Jakarta Sans (body) + JetBrains Mono, allineati al design system Credit Media */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..600,30..100&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      robots={robots}
      image={image}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="ss-skip-link" href="#main-content">Vai al contenuto</a>
    <span class="grain" aria-hidden="true"></span>
    <slot />
    {!hideStickyMobileCta && <StickyMobileCTA />}
    {/* Banner e gate del consenso sono comandati da src/lib/tracking-config.ts.
        Nessun codice e' stato rimosso: con `consentBannerEnabled = true` tutto
        torna esattamente com'era. */}
    {consentBannerEnabled && <CookieConsentBanner />}
    <GA4TrackingIsland measurementId="G-509YE5HCYB" eager={trackingEager} />
    <GoogleAdsTagIsland eager={trackingEager} />
    <ClickConversionTracking eager={trackingEager} />
    <WebsiteCallTracking eager={trackingEager} />
    <TikTokPixelTracking pixelId={tiktokPixelId} eager={trackingEager} />
    {/* Pixel Meta esteso a tutto il sito il 2026-08-14: prima viveva solo sulle
        landing, quindi home, blog e 137 pagine sede non alimentavano alcun
        pubblico di remarketing. Stessa lacuna gia' chiusa per Google Ads. */}
    <MetaPixelTracking eager={trackingEager} />
    <BehaviourTracking />
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('[data-anim="fade-up"]').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduce) {
          document.querySelectorAll('[data-anim="fade-up"]').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-anim="fade-up"]').forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
